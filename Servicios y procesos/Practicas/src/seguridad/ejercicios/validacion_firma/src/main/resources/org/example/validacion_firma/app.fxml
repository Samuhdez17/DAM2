<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.validacion_firma.AppController"
            prefWidth="850" prefHeight="600">

    <top>
        <Label text="Validación de Firma Digital RSA"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 16 0 8 16;"/>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ===== TAB SERVIDOR ===== -->
            <Tab text="Servidor">
                <VBox spacing="10">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <TextArea fx:id="logServidor"
                              promptText="Log del servidor..."
                              editable="false"
                              wrapText="true"
                              VBox.vgrow="ALWAYS"
                              prefHeight="440"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="campoMensaje"
                                   promptText="Escribe un mensaje..."
                                   HBox.hgrow="ALWAYS"
                                   onAction="#onEnviarMensaje"/>
                        <Button fx:id="btnEnviar"
                                text="Enviar"
                                onAction="#onEnviarMensaje"
                                prefWidth="90"/>
                        <Button fx:id="btnIniciarServidor"
                                text="Iniciar servidor"
                                onAction="#onIniciarServidor"
                                prefWidth="130"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ===== TAB CLIENTE ===== -->
            <Tab text="Cliente">
                <VBox spacing="10">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <TextArea fx:id="logCliente"
                              promptText="Mensajes recibidos y resultado de la verificación..."
                              editable="false"
                              wrapText="true"
                              VBox.vgrow="ALWAYS"
                              prefHeight="480"/>

                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button fx:id="btnConectar"
                                text="Conectar al servidor"
                                onAction="#onConectar"
                                prefWidth="160"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
